# ==============================================================================
# CONFIGURAÇÕES DO AMBIENTE DOCKER - MODELO (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme necessário:
#   cp .env.example .env
# ==============================================================================

# --- Portas dos Serviços (Host) ---
NGINX_PORT=80
PHPMYADMIN_PORT=8080
MARIADB_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Banco de Dados (MariaDB) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=saas_db
MYSQL_USER=saas_user
MYSQL_PASSWORD=saas_password

# --- Mensageria (RabbitMQ) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
